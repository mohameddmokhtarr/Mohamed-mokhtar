# OpenAI API Key for Whisper transcription and analysis
OPENAI_API_KEY=

# Apify API Key for social media scraping
APIFY_API_KEY=

# Optional: logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: output directory for reports
OUTPUT_DIR=reports

# Optional: number of workers for parallel processing
NUM_WORKERS=4

# Optional: rate limit pause duration (seconds)
RATE_LIMIT_PAUSE=60
