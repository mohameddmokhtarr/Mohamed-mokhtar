# OpenAI API Key
# Obtain from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-key-here

# Apify API Token
# Obtain from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_XXXXXXXXXXXXXXX

# System Configuration
LOG_LEVEL=INFO
APIFY_TIMEOUT_SECONDS=3600
OPENAI_MODEL=gpt-4-turbo-preview
WHISPER_MODEL=whisper-1
